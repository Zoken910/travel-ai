# Copy to .env and fill in real values. Never commit .env.
# Keys are added here as each phase needs them.

# Ollama (native on Windows/macOS; from inside Docker use http://host.docker.internal:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL (Phase 2)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:change-me@localhost:5432/travel

# Data providers (Phase 5+): mock | live
PROVIDER=mock
